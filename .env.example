# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is gitignored; never commit real credentials.
#
# Standard libpq variable names, so psql and other Postgres tools pick them up too.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Optional: sslmode for the connection (e.g. require, prefer, disable)
PGSSLMODE=prefer
